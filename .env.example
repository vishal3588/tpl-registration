# Copy to .env and fill in. Never commit .env.

PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# local = JSON file + uploads folder (development). google = Sheets + Drive (production).
STORAGE=local

# Comma-separated emails that get the Admin role.
ADMIN_EMAILS=you@yourdomain.com

# Restrict sign-in to these email domains. Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAINS=yourdomain.com

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application").
# Add ${BASE_URL}/auth/callback to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only when STORAGE=google.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
# Drive refresh token for your own Google account. Get both this and the folder ID by running `npm run setup:drive`.
GOOGLE_DRIVE_REFRESH_TOKEN=

# Hosts accepted for the CricHeroes profile link.
CRICHEROES_HOSTS=cricheroes.in,cricheroes.com

# Dev only: lets you sign in with any email (POST /auth/dev-login). Keep false in production.
DEV_LOGIN=false
